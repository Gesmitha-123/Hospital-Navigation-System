# PostgreSQL Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_nav

# Fallback SQLite database for instant zero-config testing if PostgreSQL is not active
FALLBACK_SQLITE=true
SQLITE_DB_PATH=hospital_nav.db

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

